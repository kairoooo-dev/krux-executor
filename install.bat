powershell -NoProfile -ExecutionPolicy Bypass -Command "
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = 'Stop'
try {
    Write-Host '  [~] Checking for updates...' -ForegroundColor Cyan
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $r = Invoke-RestMethod -Uri 'https://api.github.com/repos/kairoooo-dev/krux-executor/releases/latest' -UseBasicParsing
    $a = $r.assets | Where-Object { $_.name -like '*.exe' } | Select-Object -First 1
    if (-not $a) { throw 'No exe found' }
    $d = Join-Path $env:LOCALAPPDATA KRUX
    New-Item -ItemType Directory -Path $d -Force | Out-Null
    $f = Join-Path $env:TEMP 'KruxExecutor.exe'
    $total = $a.size
    Write-Host ''
    Write-Host '  Downloading KruxExecutor.exe' -ForegroundColor Cyan
    $wc = New-Object System.Net.WebClient
    $wc.Headers.Add('User-Agent','KRUX')
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $lastPct = -1
    $downloaded = 0
    $totalMB = [math]::Round($total/1MB,1)
    $wc.add_DownloadProgressChanged({
        param($s,$e)
        $downloaded = $e.ProgressPercentage * $total / 100
        $curMB = [math]::Round($downloaded/1MB,1)
        $pct = $e.ProgressPercentage
        $filled = [math]::Floor($pct / 2)
        $empty = 50 - $filled
        $bar = '#' * $filled + '-' * $empty
        Write-Host -NoNewline ('`r  [{0}] {1}%  {2}/{3} MB' -f $bar, $pct, $curMB, $totalMB)
    })
    $wc.DownloadFile($a.browser_download_url, $f)
    Write-Host ''
    Write-Host ''
    Write-Host '  [+] Download complete!' -ForegroundColor Green
    Copy-Item $f (Join-Path $d 'KruxExecutor.exe') -Force
    Remove-Item $f -Force
    $s = Join-Path ([Environment]::GetFolderPath('Desktop')) 'KRUX Executor.lnk'
    $sh = New-Object -ComObject WScript.Shell
    $lnk = $sh.CreateShortcut($s)
    $lnk.TargetPath = Join-Path $d 'KruxExecutor.exe'
    $lnk.WorkingDirectory = $d
    $lnk.Description = 'KRUX Executor'
    $lnk.Save()
    $s2 = Join-Path $env:APPDATA 'Microsoft\Windows\Start Menu\Programs\KRUX Executor.lnk'
    $lnk2 = $sh.CreateShortcut($s2)
    $lnk2.TargetPath = Join-Path $d 'KruxExecutor.exe'
    $lnk2.WorkingDirectory = $d
    $lnk2.Description = 'KRUX Executor'
    $lnk2.Save()
    Write-Host '  [+] Installed to' $d -ForegroundColor Green
    Write-Host '  [+] Desktop shortcut created' -ForegroundColor Green
    Write-Host ''
    Write-Host '  Starting KRUX...' -ForegroundColor Cyan
    Start-Process (Join-Path $d 'KruxExecutor.exe')
} catch {
    Write-Host ''
    Write-Host '  [-] Error:' $_.Exception.Message -ForegroundColor Red
}
"

